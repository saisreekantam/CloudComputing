# Copy to .env (`cp .env.example .env`) and fill in the REQUIRED values.
# Everything else has a sane default. Comments are on their own lines on purpose.

# ======================= LLM =======================
# REQUIRED. Any OpenAI-compatible endpoint, e.g.
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/   gemini-3.5-flash-lite (free key: https://aistudio.google.com/apikey)
#   OpenAI:    https://api.openai.com/v1                                  gpt-4o-mini
#   Anthropic: https://api.anthropic.com/v1/                              claude-haiku-5-5
#   Groq:      https://api.groq.com/openai/v1                             llama-3.3-70b-versatile (no vision → VISION_VERIFY=false)
#   Ollama:    http://host.docker.internal:11434/v1  (key: ollama)          any vision model you pull
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# Model for frame captioning; empty = LLM_MODEL. Must accept images when VISION_VERIFY=true.
LLM_VISION_MODEL=
# Global request budget per minute shared by ALL workers. Keep at or below your provider's limit.
LLM_RPM=10
# Global token budget per minute shared by all workers.
LLM_TPM=250000
VISION_VERIFY=true
# Frames per vision call (lower it for small-context self-hosted models).
VISION_BATCH=4
# Speech-to-text fallback when YouTube captions are blocked or missing (see ROADMAP.md).
ASR_FALLBACK=false
# Reuse transcripts per video id (fewer YouTube caption requests).
TRANSCRIPT_CACHE_DAYS=7
# Language the notes are written in (transcripts in other languages are translated).
NOTES_LANGUAGE=English
# Minimum frames per page; tops up talking-head videos with per-section real frames.
MIN_FRAMES=3
# Visual-first frame selection (scan the video, pick informative on-screen visuals).
VISUAL_SCAN=false
VISUAL_CANDIDATES=16
# Concept map + links between pages that share concepts.
CONCEPT_GRAPH=false

# ======================= Notion =======================
# REQUIRED for the OAuth flow. Create a *public* integration at https://www.notion.so/profile/integrations
# and register this redirect URI (the extension id is pinned by the key in manifest.json):
#   https://affbfbcfcpadfbncfklibpgnpoahjlff.chromiumapp.org/notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional fixed destination page/database id (see README "Default Notion destination").
NOTION_DEFAULT_PARENT_ID=
# Requests/second per Notion token (Notion allows ~3 req/s on average).
NOTION_RPS=2.5
# Optional: internal-integration token used when a request omits notion_token (curl testing only).
NOTION_FALLBACK_TOKEN=

# ======================= Retry / backoff =======================
# Runs per stage for ordinary errors before the job is DEAD_LETTERED.
MAX_ATTEMPTS=5
# Backoff schedule in seconds (attempt 1, 2, 3, 4+). Demo-friendly: 2,4,8,16
RETRY_BACKOFF_SECONDS=10,30,90,270
# Separate retry budget for HTTP 429s (rate limits) from any external API.
MAX_RATE_LIMIT_RETRIES=8
# Stage lease. A crashed worker's stage is resumed by another worker within this time.
LEASE_SECONDS=12
# How many times one stage may crash workers before it is quarantined in the DLQ.
CRASH_REDELIVERY_LIMIT=4

# ======================= Misc =======================
# Constraint A: maximum supported video length (20 minutes).
MAX_VIDEO_SECONDS=1200
MAX_FRAMES=10
YOUTUBE_RPM=30
# Token for /admin/* endpoints.
ADMIN_TOKEN=dev-admin
# Fernet key used to encrypt Notion tokens at rest in Redis. Generate with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENC_KEY=
